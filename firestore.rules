rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Dados do usuário — somente o próprio usuário lê/escreve
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Ativações pendentes (Hotmart/testadores) — usuário autenticado lê/deleta a própria entrada
    match /pending_activations/{email} {
      allow read, delete: if request.auth != null
                           && request.auth.token.email.lower() == email;
      allow write: if false; // Somente Firebase Admin (servidor) pode criar
    }

    // GPS da Economia — promoções
    match /promocoes/{promoId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
                              && request.auth.uid == resource.data.criadoPorUid;
    }

    // GPS da Economia — dados do usuário no ranking
    match /usuarios_gps/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
